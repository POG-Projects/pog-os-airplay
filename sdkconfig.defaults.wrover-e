# ESP32-WROVER-E, 4 MB flash; PSRAM is detected by ESP-IDF at boot.
CONFIG_BOARD_WROVER_E=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHMODE="dio"
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="components/boards/partitions-4m.csv"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_BT_ENABLED=n
CONFIG_BT_A2DP_ENABLE=n
CONFIG_DISPLAY_ENABLED=n

# Reference wiring only: confirm the physical board before flashing.
# Independent I2S bus for a future microphone; never use flash/PSRAM pins.
CONFIG_I2S_SCK_IO=-1
CONFIG_I2S_BCK_IO=33
CONFIG_I2S_WS_IO=25
CONFIG_I2S_DO_IO=32
CONFIG_I2S_GND_IO=-1
CONFIG_I2S_VCC_IO=-1
CONFIG_DAC_I2C_SDA=-1
CONFIG_DAC_I2C_SCL=-1
CONFIG_SPDIF_DO_IO=-1
CONFIG_LED_RGB_GPIO=-1
CONFIG_BTN_PLAY_PAUSE_GPIO=0

# Driver available, but no microphone GPIO is configured by default.
CONFIG_POG_MICROPHONE=y
