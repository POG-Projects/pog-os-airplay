menu "POG device integration"

    config POGDEV_HOME_FALLBACK_URL
        string "Fallback POG Home URL"
        default ""
        help
            Optional base URL used when _poghome._tcp remains undiscovered for
            30 seconds. Protocol v1 accepts an HTTP URL such as
            http://192.168.1.20:8090. Leave empty to rely exclusively on mDNS.

endmenu
